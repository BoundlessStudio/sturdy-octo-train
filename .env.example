# Set all three values to enable live builds. The app runs in demo mode without them.
# https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=
AGENT37_SHARED_INSTANCE_ID=
SCROLLWORKS_INSTANCE_TOKEN=

# Monthly managed-model spending limit in micros, applied by npm run setup:shared on creation.
# AGENT37_BUDGET_MICROS=1000000

# Node serves on loopback by default. Set a strong password before exposing it over HTTPS.
# HOST=0.0.0.0
# PORT=3000
# BUILDER_ACCESS_TOKEN=
# BUILDER_ORIGIN=https://scrollworks.example.com
