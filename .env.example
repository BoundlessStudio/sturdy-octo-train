# Set a workspace key to enable live builds. The app runs in demo mode without it.
# https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=

# Live builds use an Agent37 sandbox and managed-model credits from your workspace.
# AGENT37_BUDGET_MICROS=1000000

# Node serves on loopback by default. Set a strong password before exposing it over HTTPS.
# HOST=0.0.0.0
# PORT=3000
# BUILDER_ACCESS_TOKEN=
# BUILDER_ORIGIN=https://scrollworks.example.com
